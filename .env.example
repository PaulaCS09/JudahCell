# ─── JUDAH CELL · Variables de entorno de ejemplo ───────────────────────────
# Copia este archivo como .env.local y completa los valores. NUNCA subas .env.local a git.

# Google Gemini (Asesor JUDAH). Crea tu clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar. Revisa los modelos disponibles en tu cuenta en https://ai.google.dev/gemini-api/docs/models
# Un modelo "Flash" o "Flash-Lite" es suficiente y suele estar en la capa gratuita.
GEMINI_MODEL=gemini-flash-latest

# Base de datos (libSQL / SQLite).
# Local: archivo SQLite. Producción: una base Turso (libsql://...) con su token.
DATABASE_URL=file:./data/judah.db
DATABASE_AUTH_TOKEN=

# Límite de mensajes al asesor por IP y por minuto (protección básica de costos/abuso)
CHAT_RATE_LIMIT_PER_MIN=12
